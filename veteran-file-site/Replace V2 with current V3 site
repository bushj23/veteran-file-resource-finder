/* V3.1: zero-JavaScript mobile navigation */
.mobile-menu { display:none; position:relative; }
.mobile-menu-toggle {
  position:absolute;
  opacity:0;
  pointer-events:none;
  width:1px;
  height:1px;
}
@media(max-width:850px){
  #mainNav { display:none !important; }
  .mobile-menu { display:block !important; }
  .mobile-menu .menu-btn {
    display:block !important;
    cursor:pointer;
    user-select:none;
    -webkit-user-select:none;
    -webkit-tap-highlight-color:transparent;
    position:relative;
    z-index:10001;
    min-width:64px;
    text-align:center;
    background:transparent;
    color:#fff;
    border:1px solid #61718a;
    border-radius:8px;
    padding:8px 10px;
  }
  .mobile-menu #mobileNav {
    display:none !important;
    position:absolute !important;
    left:auto !important;
    right:0 !important;
    top:48px !important;
    width:min(84vw,320px) !important;
    background:#06152d !important;
    border:1px solid #31445f;
    border-radius:12px;
    padding:10px !important;
    box-shadow:0 18px 45px rgba(0,0,0,.35);
    z-index:10000;
  }
  .mobile-menu-toggle:checked ~ #mobileNav {
    display:flex !important;
    flex-direction:column;
    gap:4px;
  }
  .mobile-menu #mobileNav a {
    display:block;
    width:100%;
    padding:13px 12px;
    color:#fff;
    text-decoration:none;
    font-weight:800;
    border-radius:8px;
  }
}

/* V3.1: zero-JavaScript "Where Do I Start?" cards */
.native-wizard details {
  background:#0e2e58;
  border:1px solid #2c4b72;
  color:#fff;
  border-radius:14px;
  overflow:hidden;
}
.native-wizard summary {
  list-style:none;
  cursor:pointer;
  padding:19px;
  user-select:none;
  -webkit-user-select:none;
  -webkit-tap-highlight-color:transparent;
}
.native-wizard summary::-webkit-details-marker { display:none; }
.native-wizard summary strong,
.native-wizard summary small { display:block; }
.native-wizard summary small { color:#b8c5d7; margin-top:5px; }
.native-wizard details[open] { background:#123a69; }
.native-wizard .wizard-answer {
  padding:0 19px 19px;
  border-top:1px solid #36547b;
}
.native-wizard .wizard-answer p { color:#d7e0ed; }
.native-wizard .wizard-answer a {
  display:inline-block;
  background:#fff;
  color:#0b254c;
  text-decoration:none;
  font-weight:900;
  padding:10px 12px;
  border-radius:8px;
}

/* V3.3 bulletproof mobile navigation: no mobile menu toggle */
.mobile-direct-link { display:none; }
.mobile-quick-nav { display:none; }

.start-link-grid {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:13px;
}
.start-link-grid a {
  display:block;
  background:#0e2e58;
  border:1px solid #2c4b72;
  color:#fff;
  border-radius:14px;
  padding:19px;
  text-decoration:none;
  min-height:150px;
}
.start-link-grid a strong,
.start-link-grid a small,
.start-link-grid a span { display:block; }
.start-link-grid a small { color:#b8c5d7; margin-top:5px; }
.start-link-grid a span { margin-top:18px; font-weight:900; color:#fff; }

@media(max-width:850px){
  .site-header #mainNav { display:none !important; }
  .menu-btn,
  .mobile-menu,
  .mobile-menu-toggle { display:none !important; }

  .mobile-direct-link {
    display:inline-flex;
    align-items:center;
    justify-content:center;
    background:#df1d31;
    color:#fff;
    padding:9px 12px;
    border-radius:9px;
    text-decoration:none;
    font-weight:900;
    white-space:nowrap;
  }

  .mobile-quick-nav {
    display:grid;
    grid-template-columns:repeat(4,1fr);
    position:sticky;
    top:80px;
    z-index:45;
    background:#081a35;
    border-bottom:1px solid #263c5b;
  }
  .mobile-quick-nav a {
    display:flex;
    align-items:center;
    justify-content:center;
    min-height:48px;
    padding:8px 4px;
    color:#fff;
    text-decoration:none;
    font-size:11px;
    font-weight:850;
    text-align:center;
    border-right:1px solid #263c5b;
  }

  .start-link-grid { grid-template-columns:1fr 1fr; }
}

@media(max-width:560px){
  .brand div span { display:none; }
  .mobile-quick-nav { top:80px; }
  .start-link-grid { grid-template-columns:1fr; }
  .start-link-grid a { min-height:auto; }
}

