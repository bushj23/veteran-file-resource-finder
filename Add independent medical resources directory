
.medical-hero{
  background:
    radial-gradient(circle at 78% 16%, rgba(34,78,130,.72), transparent 34%),
    linear-gradient(135deg,#06152d,#0b254c);
  color:#fff;
  padding:82px 0;
}
.medical-hero-grid{
  display:grid;
  grid-template-columns:1.2fr .8fr;
  gap:60px;
  align-items:center;
}
.medical-hero h1{
  font-size:clamp(40px,5vw,66px);
  line-height:1.03;
  letter-spacing:-.04em;
  margin:12px 0 20px;
}
.medical-lead{
  color:#d5dfec;
  font-size:19px;
  max-width:760px;
}
.medical-hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}
.medical-outline{
  border:1px solid #8ea0b9;
  color:#fff;
  background:transparent;
}
.medical-hero-card{
  background:#fff;
  color:#0b1730;
  border-radius:22px;
  padding:28px;
  box-shadow:0 28px 65px rgba(0,0,0,.34);
}
.medical-hero-card p{color:#536176}
.medical-shield{
  width:62px;
  height:62px;
  border-radius:16px;
  display:grid;
  place-items:center;
  background:#eef3f9;
  color:#c9142f;
  font-size:31px;
  margin-bottom:18px;
}
.medical-disclaimer{
  background:#fff5f6;
  border-bottom:1px solid #edc6cb;
  color:#5d2630;
}
.medical-disclaimer .shell{
  padding:17px 0;
  display:flex;
  gap:10px;
}
.provider-tools{
  display:grid;
  grid-template-columns:1.5fr 1fr 1fr;
  gap:14px;
  background:#fff;
  border:1px solid #dfe6ef;
  border-radius:18px;
  padding:20px;
  box-shadow:0 10px 28px rgba(16,32,64,.06);
}
.provider-tools label{
  display:block;
  font-size:13px;
  font-weight:900;
  margin-bottom:7px;
}
.provider-tools input,
.provider-tools select{
  width:100%;
  min-height:46px;
  border:1px solid #c9d3df;
  border-radius:10px;
  padding:11px 12px;
  background:#fff;
  color:#0b1730;
}
.provider-status{min-height:24px;color:#536176;margin:13px 0}
.provider-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:16px;
}
.provider-card,
.provider-empty{
  background:#fff;
  border:1px solid #dfe6ef;
  border-radius:17px;
  padding:22px;
  box-shadow:0 8px 25px rgba(16,32,64,.05);
}
.provider-card{display:flex;flex-direction:column;min-height:300px}
.provider-card h3{margin:6px 0 3px;font-size:21px}
.provider-credentials{font-size:12px;font-weight:900;color:#345a87}
.provider-specialty{color:#536176;font-size:14px}
.provider-tags{display:flex;gap:7px;flex-wrap:wrap;margin:14px 0}
.provider-tag{
  border-radius:999px;
  padding:6px 9px;
  font-size:11px;
  font-weight:850;
  background:#eef3f9;
  color:#274d78;
}
.provider-meta{margin-top:auto;color:#536176;font-size:13px}
.provider-card a{color:#9f1427;font-weight:900}
.provider-empty{grid-column:1/-1;text-align:center;padding:42px 24px}
.provider-empty h3{margin-top:0}
.provider-empty p{max-width:680px;margin:0 auto;color:#536176}

.medical-how{background:#071a38;color:#fff}
.medical-how .section-heading p{color:#c7d2e0!important}
.medical-how .kicker{color:#ff6478!important}
.medical-info-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:15px;
}
.medical-info-grid article{
  background:#0e2e58;
  border:1px solid #2e4c72;
  border-radius:16px;
  padding:22px;
}
.medical-info-grid article>span{
  width:38px;height:38px;border-radius:50%;
  display:grid;place-items:center;
  background:#df1d31;color:#fff;font-weight:950;
}
.medical-info-grid h3{margin:16px 0 8px}
.medical-info-grid p{color:#c7d2e0}

.medical-listing-note{background:#eef3f9}
.medical-listing-inner{
  display:grid;
  grid-template-columns:1.1fr .9fr;
  gap:35px;
  align-items:start;
}
.medical-listing-inner h2{
  font-size:clamp(32px,4vw,47px);
  line-height:1.08;
  margin:8px 0 14px;
}
.medical-listing-inner p{color:#536176}
.medical-review-box{
  background:#fff;
  border:1px solid #dbe3ed;
  border-radius:17px;
  padding:22px;
}
.medical-review-box ul{padding-left:20px;color:#536176}
.medical-review-box li{margin:7px 0}

@media(max-width:850px){
  .medical-hero-grid,
  .medical-listing-inner{grid-template-columns:1fr}
  .provider-tools{grid-template-columns:1fr}
  .provider-grid{grid-template-columns:1fr 1fr}
  .medical-info-grid{grid-template-columns:1fr}
}
@media(max-width:560px){
  .medical-hero{padding:55px 0}
  .medical-hero h1{font-size:42px}
  .provider-grid{grid-template-columns:1fr}
  .medical-disclaimer .shell{flex-direction:column}
}

